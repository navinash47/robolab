# Copy to .env and fill in real values. Never commit .env.

RUNPOD_API_KEY=
# Network volume ID from https://www.runpod.io/console/user/storage (mounted at /workspace)
RUNPOD_NETWORK_VOLUME_ID=
# Image RunPod can pull (build + push: make worker-image && docker push …)
ROBOLAB_WORKER_IMAGE=robolab/worker:phase3
# HTTPS git URL the pod clones at GIT_SHA (required for runpod; repo must be clean+pushed)
ROBOLAB_GIT_URL=
# Public URL of this FastAPI backend (ngrok / Cloudflare Tunnel). Pods cannot reach localhost.
BACKEND_PUBLIC_URL=
# COMMUNITY | SECURE | ALL
RUNPOD_CLOUD_TYPE=COMMUNITY
# Hard wall-clock per pod (minutes); watchdog + entrypoint env
MAX_RUNTIME_MIN=120
# Optional: private clone
# GITHUB_TOKEN=

WANDB_API_KEY=
WANDB_PROJECT=robolab
# Optional: org/team entity if the key is scoped to a team (e.g. umass)
# WANDB_ENTITY=
ANTHROPIC_API_KEY=

# Monthly spend cap in USD. Dashboard shows remaining = cap - month ledger.
# Refuse new RunPod launches when month_spend >= cap.
BUDGET_USD_CAP=100
