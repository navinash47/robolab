# Copy to .env and fill in real values. Never commit .env.

# --- Phase 3 RunPod (paid gate) ---
# API key from https://www.runpod.io/console/user/settings (≠ Cursor MCP OAuth)
RUNPOD_API_KEY=

# Network volume id from https://www.runpod.io/console/user/storage (mounted at /workspace).
# Size tip: 50GB recommended (checkpoints + uv cache). Create in a US DC that has your GPU.
# Do not create until you are ready to pay storage — agent will not auto-create unless asked.
RUNPOD_NETWORK_VOLUME_ID=

# Image RunPod can pull. Build + push locally:
#   make worker-image IMAGE=YOURUSER/robolab-worker:phase3
#   docker login && docker push YOURUSER/robolab-worker:phase3
ROBOLAB_WORKER_IMAGE=YOURUSER/robolab-worker:phase3

# HTTPS git URL the pod clones at GIT_SHA (repo must be clean + pushed).
# This clone's remote: https://github.com/navinash47/robolab.git
ROBOLAB_GIT_URL=https://github.com/navinash47/robolab.git

# Required while the GitHub repo is private (classic PAT with repo scope).
# GITHUB_TOKEN=

# Public URL of this FastAPI backend (pods cannot reach localhost).
# Free: cloudflared tunnel --url http://127.0.0.1:8000
# Then set BACKEND_PUBLIC_URL to the https://….trycloudflare.com URL (no trailing slash).
BACKEND_PUBLIC_URL=

# COMMUNITY | SECURE | ALL
RUNPOD_CLOUD_TYPE=COMMUNITY
# Hard wall-clock per pod (minutes); watchdog + entrypoint env
MAX_RUNTIME_MIN=120

# --- Experiment tracking / LLM ---
WANDB_API_KEY=
WANDB_PROJECT=robolab
# Optional: org/team entity if the key is scoped to a team (e.g. umass)
# WANDB_ENTITY=
ANTHROPIC_API_KEY=

# Monthly spend cap in USD. Dashboard shows remaining = cap - month ledger.
# Refuse new RunPod launches when month_spend >= cap.
BUDGET_USD_CAP=100
