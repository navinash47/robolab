<mujoco model="diffdrive_open">
  <!-- Open arena for go_to_goal / figure8_tracking. Same robot as scene.xml. -->
  <compiler angle="radian" balanceinertia="true" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <geom friction="1 0.5 0.01" rgba="0.7 0.7 0.7 1"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="15 8 0.05" rgba="0.85 0.88 0.9 1" friction="1 0.5 0.01"/>

    <geom name="wall_w" type="box" pos="-2.0 0 0.25" size="0.1 4.0 0.25" rgba="0.5 0.5 0.5 1"/>
    <geom name="wall_e" type="box" pos="8.0 0 0.25" size="0.1 4.0 0.25" rgba="0.5 0.5 0.5 1"/>
    <geom name="wall_n" type="box" pos="3.0 4.0 0.25" size="5.1 0.1 0.25" rgba="0.5 0.5 0.5 1"/>
    <geom name="wall_s" type="box" pos="3.0 -4.0 0.25" size="5.1 0.1 0.25" rgba="0.5 0.5 0.5 1"/>

    <!-- Visual goal marker (no collision) for go_to_goal. -->
    <geom name="goal_marker" type="cylinder" size="0.25 0.02" pos="5.0 1.5 0.02" rgba="0.2 0.8 0.3 0.5" contype="0" conaffinity="0" group="0"/>

    <body name="base" pos="0.5 0 0.05">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.15 0.12 0.04" pos="0 0 0.09" mass="4.0" rgba="0.15 0.35 0.75 1" group="1" contype="1" conaffinity="1"/>
      <geom name="lidar_mount" type="cylinder" size="0.03 0.02" pos="0.08 0 0.15" mass="0.05" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0" group="1"/>

      <body name="left_wheel" pos="0 0.14 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.1"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.05 0.02" quat="0.7071 0.7071 0 0" mass="0.4" rgba="0.1 0.1 0.1 1" friction="1.5 0.5 0.01" group="1" contype="0" conaffinity="0"/>
      </body>
      <body name="right_wheel" pos="0 -0.14 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.1"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.05 0.02" quat="0.7071 0.7071 0 0" mass="0.4" rgba="0.1 0.1 0.1 1" friction="1.5 0.5 0.01" group="1" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>
</mujoco>
