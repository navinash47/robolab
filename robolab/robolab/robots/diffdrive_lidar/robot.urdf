<?xml version="1.0"?>
<!-- Canonical RoboMaster-ish differential-drive (top-down silhouette). Same URDF for all sims. -->
<robot name="diffdrive_lidar">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.55 0.42 0.12"/>
      </geometry>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <material name="hull">
        <color rgba="0.12 0.14 0.18 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.55 0.42 0.12"/>
      </geometry>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
    </collision>
    <inertial>
      <origin xyz="0 0 0.11" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.12" ixy="0" ixz="0" iyy="0.15" iyz="0" izz="0.18"/>
    </inertial>
  </link>

  <link name="armor_front">
    <visual>
      <geometry>
        <box size="0.08 0.36 0.10"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="armor_red">
        <color rgba="0.85 0.15 0.12 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.36 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.075" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="dark">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.075" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.075" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <material name="dark">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.075" length="0.06"/>
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="armor_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="armor_front"/>
    <origin xyz="0.24 0 0.12" rpy="0 0 0"/>
  </joint>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.22 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.22 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
